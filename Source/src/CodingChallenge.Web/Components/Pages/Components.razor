@page "/components"
@inject CodingChallenge.Web.ApiClients.ComponentsApiClient ComponentsApi

<PageTitle>Components</PageTitle>

<h1>Components</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width: 300px" placeholder="Search components..." @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
    <button class="btn btn-primary" @onclick="ShowCreateForm">New Component</button>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_components is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            @if (_totalCount == 0)
            {
                <span>No components found.</span>
            }
            else
            {
                <span>Showing @FirstItemNumber-@LastItemNumber of @_totalCount components</span>
            }
        </small>
        <small class="text-muted">Page @_currentPage of @Math.Max(_totalPages, 1)</small>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Quantity</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var component in _components)
            {
                <tr>
                    <td>@component.Name</td>
                    <td>@component.Description</td>
                    <td>@component.Quantity</td>
                    <td class="d-flex gap-1">
                        <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditForm(component)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(component.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
        <button class="btn btn-sm btn-outline-secondary"
                disabled="@(_currentPage <= 1)"
                @onclick="PreviousPage">
            Previous
        </button>
        <span>Page @_currentPage / @Math.Max(_totalPages, 1)</span>
        <button class="btn btn-sm btn-outline-secondary"
                disabled="@(_totalPages == 0 || _currentPage >= _totalPages)"
                @onclick="NextPage">
            Next
        </button>
    </div>
}

@if (_editModel is not null)
{
    <div class="card p-3 mt-3" style="max-width: 500px">
        <h3>@(_editingId is null ? "New Component" : "Edit Component")</h3>
        <EditForm Model="_editModel" OnValidSubmit="Save">
            <div class="mb-2">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="_editModel.Name" />
            </div>
            <div class="mb-2">
                <label>Description</label>
                <InputTextArea class="form-control" @bind-Value="_editModel.Description" />
            </div>
            <div class="mb-2">
                <label>Quantity</label>
                <InputNumber class="form-control" @bind-Value="_editModel.Quantity" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-link" @onclick="CancelEdit">Cancel</button>
        </EditForm>
    </div>
}

@code {
    private List<ComponentDto>? _components;
    private const int PageSize = 100;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _totalCount;
    private int _totalPages;
    private string? _errorMessage;
    private int? _editingId;
    private ComponentEditModel? _editModel;

    protected override async Task OnInitializedAsync()
    {
        await LoadComponents();
    }

    private async Task LoadComponents()
    {
        var result = await ComponentsApi.GetPageAsync(_searchTerm, _currentPage, PageSize);

        if (result.TotalPages > 0 && _currentPage > result.TotalPages)
        {
            _currentPage = result.TotalPages;
            result = await ComponentsApi.GetPageAsync(_searchTerm, _currentPage, PageSize);
        }

        _components = result.Items;
        _totalCount = result.TotalCount;
        _totalPages = result.TotalPages;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        _currentPage = 1;
        await LoadComponents();
    }

    private async Task PreviousPage()
    {
        if (_currentPage <= 1)
        {
            return;
        }

        _currentPage--;
        await LoadComponents();
    }

    private async Task NextPage()
    {
        if (_totalPages == 0 || _currentPage >= _totalPages)
        {
            return;
        }

        _currentPage++;
        await LoadComponents();
    }

    private int FirstItemNumber => _totalCount == 0 ? 0 : ((_currentPage - 1) * PageSize) + 1;
    private int LastItemNumber => Math.Min(_currentPage * PageSize, _totalCount);

    private void ShowCreateForm()
    {
        _errorMessage = null;
        _editingId = null;
        _editModel = new ComponentEditModel();
    }

    private void ShowEditForm(ComponentDto component)
    {
        _errorMessage = null;
        _editingId = component.Id;
        _editModel = new ComponentEditModel
        {
            Name = component.Name,
            Description = component.Description,
            Quantity = component.Quantity
        };
    }

    private void CancelEdit()
    {
        _editModel = null;
        _editingId = null;
    }

    private async Task Save()
    {
        if (_editModel is null)
        {
            return;
        }

        if (_editingId is null)
        {
            await ComponentsApi.CreateAsync(new ComponentCreateDto(_editModel.Name, _editModel.Description, _editModel.Quantity));
        }
        else
        {
            await ComponentsApi.UpdateAsync(_editingId.Value, new ComponentUpdateDto(_editModel.Name, _editModel.Description, _editModel.Quantity));
        }

        CancelEdit();
        await LoadComponents();
    }

    private async Task Delete(int id)
    {
        _errorMessage = null;
        var success = await ComponentsApi.DeleteAsync(id);
        if (!success)
        {
            _errorMessage = "Could not delete the component.";
        }

        await LoadComponents();
    }

    private class ComponentEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int Quantity { get; set; }
    }
}
