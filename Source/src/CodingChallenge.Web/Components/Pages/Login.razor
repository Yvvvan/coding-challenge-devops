@page "/login"
@inject CodingChallenge.Web.ApiClients.AuthApiClient AuthApi
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-panel">
    <div class="card p-3">
        <h1>Sign in</h1>
        <div class="mb-3">
            <label class="form-label">User name</label>
            <input class="form-control" @bind="_username" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input class="form-control" type="password" @bind="_password" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <button class="btn btn-primary" @onclick="SignIn" disabled="@_busy">
            @(_busy ? "Signing in..." : "Sign in")
        </button>
    </div>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task SignIn()
    {
        _busy = true;
        _error = null;

        var success = await AuthApi.LoginAsync(_username, _password);

        _busy = false;

        if (success)
        {
            Navigation.NavigateTo("/", forceLoad: false);
        }
        else
        {
            _error = $"Login failed for user '{_username}' with password '{_password}'.";
        }
    }
}
