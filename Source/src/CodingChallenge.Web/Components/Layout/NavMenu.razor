@implements IDisposable
@inject CodingChallenge.Web.ApiClients.UserSession Session
@inject NavigationManager Navigation

@if (Session.IsAuthenticated)
{
    <input type="checkbox" id="nav-toggle" title="Navigation menu" class="navbar-toggler" />
}

<div class="header-top">
    <div class="header-inner">
        <a class="navbar-brand" href="">
            <img src="images/asm-logo.jpg" alt="ASMPT" class="brand-logo" />
            <span class="brand-text">
                <span class="brand-title">CodingChallenge</span>
                <span class="brand-claim">Enabling the digital world</span>
            </span>
        </a>

        <div class="header-session">
            @if (Session.IsAuthenticated)
            {
                <span class="session-user">@Session.Username</span>
                <button type="button" class="btn btn-sm btn-secondary" @onclick="Logout">Log Out</button>
            }
            else
            {
                <NavLink class="session-link" href="login">Sign in</NavLink>
            }
        </div>

        @if (Session.IsAuthenticated)
        {
            <label class="navbar-toggler-icon" for="nav-toggle" aria-label="Toggle navigation"></label>
        }
    </div>
</div>

@if (Session.IsAuthenticated)
{
    <div class="header-nav">
        <div class="header-inner">
            <nav class="nav-scrollable">
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="orders">
                        Orders
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="boards">
                        Boards
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="components">
                        Components
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        Session.SignOut();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
