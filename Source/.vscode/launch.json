{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build (solution)",
            "program": "${workspaceFolder}/src/CodingChallenge.Api/bin/Debug/net10.0/CodingChallenge.Api.dll",
            "cwd": "${workspaceFolder}/src/CodingChallenge.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build (solution)",
            "program": "${workspaceFolder}/src/CodingChallenge.Web/bin/Debug/net10.0/CodingChallenge.Web.dll",
            "cwd": "${workspaceFolder}/src/CodingChallenge.Web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            "name": "API + Web",
            "configurations": ["API", "Web"]
        }
    ]
}
